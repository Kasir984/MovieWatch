<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!--
			REMOVED: the old template line below was the cause of XA0035.
			When VS builds in Release it evaluates RuntimeIdentifier=win-x64 globally.
			That condition was true, which meant the value 'win-x64' bled into the
			Android build and the Android tooling couldn't map it to an ABI.

			<TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'win-x64' or ...">
				net10.0-windows10.0.19041.0
			</TargetFrameworks>
		-->

		<OutputType>Exe</OutputType>
		<RootNamespace>MovieWatch</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable LLVM AOT compilation for Android to avoid precompilation errors -->
		<AndroidEnableLLVM Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</AndroidEnableLLVM>

		<!-- Display name -->
		<ApplicationTitle>MovieWatch</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.moviewatch</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<UseDefaultPublishRuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</UseDefaultPublishRuntimeIdentifier>
		<EnableMauiFontProcessing Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</EnableMauiFontProcessing>
		<DefaultLanguage>en-US</DefaultLanguage>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
		<BaseOutputPath>C:\Users\Spagget\source\repos\MovieWatch\MovieWatch\bin</BaseOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\movie_watch_icon.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\OpenSans-Regular.ttf" Alias="OpenSansRegular" />
		<MauiFont Include="Resources\Fonts\OpenSans-Semibold.ttf" Alias="OpenSansSemibold" />
		<MauiFont Include="Resources\Fonts\Rajdhani-SemiBold.ttf" Alias="RajdhaniSemiBold" />
		<MauiFont Include="Resources\Fonts\Rajdhani-Medium.ttf" Alias="RajdhaniMedium" />
		<MauiFont Include="Resources\Fonts\Rajdhani-Bold.ttf" Alias="RajdhaniBold" />
		<MauiFont Include="Resources\Fonts\JetBrainsMono-SemiBold.ttf" Alias="JetBrainsMonoSemiBold" />
		<MauiFont Include="Resources\Fonts\LobsterTwo-Bold.ttf" Alias="LobsterTwoBold" />
		<MauiFont Include="Resources\Fonts\LobsterTwo-Regular.ttf" Alias="LobsterTwoRegular" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidAsset Include="Resources\Fonts\OpenSans-Regular.ttf" Link="OpenSans-Regular.ttf" />
		<AndroidAsset Include="Resources\Fonts\OpenSans-Semibold.ttf" Link="OpenSans-Semibold.ttf" />
		<AndroidAsset Include="Resources\Fonts\Rajdhani-SemiBold.ttf" Link="Rajdhani-SemiBold.ttf" />
		<AndroidAsset Include="Resources\Fonts\Rajdhani-Medium.ttf" Link="Rajdhani-Medium.ttf" />
		<AndroidAsset Include="Resources\Fonts\Rajdhani-Bold.ttf" Link="Rajdhani-Bold.ttf" />
		<AndroidAsset Include="Resources\Fonts\JetBrainsMono-SemiBold.ttf" Link="JetBrainsMono-SemiBold.ttf" />
		<AndroidAsset Include="Resources\Fonts\LobsterTwo-Bold.ttf" Link="LobsterTwo-Bold.ttf" />
		<AndroidAsset Include="Resources\Fonts\LobsterTwo-Regular.ttf" Link="LobsterTwo-Regular.ttf" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="14.1.1" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="9.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.70" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
		<PackageReference Include="Microsoft.Maui.Core" Version="10.0.70" />
		<PackageReference Include="PusherClient" Version="2.2.1" />
	</ItemGroup>

	<!--
		Linker.xml tells the Release-mode IL trimmer to preserve these assemblies.
		PusherClient and Newtonsoft.Json rely on reflection for event binding and
		JSON serialisation — without this they get partially stripped and crash at runtime.
	-->
	<ItemGroup>
		<TrimmerRootDescriptor Include="Linker.xml" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Pages\MyButton.xaml.cs">
			<DependentUpon>MyButton.xaml</DependentUpon>
		</Compile>
		<Compile Update="Pages\VideoPlayer.xaml.cs">
			<DependentUpon>VideoPlayer.xaml</DependentUpon>
		</Compile>
		<Compile Update="Pages\UpdateProgressPage.xaml.cs">
			<DependentUpon>UpdateProgressPage.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Pages\MyButton.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\UpdateProgressPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\VideoPlayer.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<Target Name="KeepOnlyEnglishWindowsResources" AfterTargets="Build" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ItemGroup>
			<_NonEnglishMuiFiles Include="$(OutputPath)**\*.mui" Exclude="$(OutputPath)en-us\**\*.mui;$(OutputPath)en-US\**\*.mui" />
			<_NonEnglishMuiDirectories Include="@(_NonEnglishMuiFiles->'%(RootDir)%(Directory)')" />
		</ItemGroup>
		<Delete Files="@(_NonEnglishMuiFiles)" />
		<RemoveDir Directories="@(_NonEnglishMuiDirectories)" />
	</Target>

	<Target Name="CopyReleaseApkWithFriendlyName" AfterTargets="Build" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
		<ItemGroup>
			<_SignedReleaseApk Include="$(OutputPath)*-Signed.apk" />
		</ItemGroup>
		<Copy SourceFiles="@(_SignedReleaseApk)" DestinationFiles="@(_SignedReleaseApk->'$(OutputPath)$(ApplicationTitle).apk')" SkipUnchangedFiles="true" />
	</Target>

</Project>
